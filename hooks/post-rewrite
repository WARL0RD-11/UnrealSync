#!/bin/sh
# Managed by UnrealSync — rebase completion (post-rewrite stdin contains old/new mappings).
[ "$1" = "rebase" ] || exit 0
ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
SCRIPT="$ROOT/.unrealsync/UnrealSync.ps1"
[ -f "$SCRIPT" ] || exit 0
OLD="$(git rev-parse ORIG_HEAD 2>/dev/null)" || OLD=""
NEW="$(git rev-parse HEAD 2>/dev/null)" || exit 0
if [ -z "$OLD" ] || [ "$OLD" = "$NEW" ]; then exit 0; fi
printf '[UnrealSync] Rebase completed, checking Unreal changes...\n'
powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$SCRIPT" -Mode Auto -OldRevision "$OLD" -NewRevision "$NEW"
RESULT=$?
if [ "$RESULT" -ne 0 ]; then
  echo '[UnrealSync] Build failed or was deferred. Check the .git/unrealsync status and log.' >&2
fi
exit 0
